{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": "src",
    "paths": {
      "@commands/*": ["./src/commands/*"],
      "@services/*": ["./src/services/*"],
      "@constants": ["./src/constants"],
      "@interfaces/*": ["./src/interfaces/*"]
    },
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/test/**/*"]
}
